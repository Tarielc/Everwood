# Leaderboard API (the Vercel function in api/) - set these in the Vercel project's
# Environment Variables, or in .env.local for `vercel dev`. Never commit the real URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Everwood
# Optional - database name, defaults to "everwood"
MONGODB_DB=everwood

# Game (read at build time by Vite) - optional, only when the API lives somewhere other
# than /api/arena/leaderboard on the same origin as the game
# VITE_LEADERBOARD_URL=https://example.com/api/arena/leaderboard
